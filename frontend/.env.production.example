# Production Frontend Environment Variables Template (Vercel)
# Configure these in the Vercel Project Settings -> Environment Variables

# Backend API Base URL (Point to your Hostinger VPS backend domain with HTTPS)
# Do NOT include a trailing slash
NEXT_PUBLIC_API_BASE_URL=https://api.YOUR_DOMAIN.com

# Legacy / alternate variable name supported by the client
NEXT_PUBLIC_API_URL=https://api.YOUR_DOMAIN.com

# Optional: API Key if API_KEY is enabled on the backend
# NEXT_PUBLIC_API_KEY=your-production-secret-api-key
