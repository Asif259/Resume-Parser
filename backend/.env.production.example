# Production Backend Environment Variables Template
# Copy this file to .env on the Hostinger VPS at /opt/resume-parser/.env

# Application Environment (production / development)
APP_ENV=production

# Server & Project Info
PROJECT_NAME="NLP Resume Parser API"

# Database Configuration (Persistent SQLite path inside container)
DATABASE_URL=sqlite:////app/data/resumes.db

# Storage Directories
UPLOAD_DIR=/app/uploads
MODEL_DIR=/app/models/ner
HF_HOME=/app/cache/huggingface

# Force CPU inference (avoids CUDA searching overhead on CPU VPS)
FORCE_CPU=true

# ML & Hybrid Pipeline Controls
USE_ML=true
USE_SEMANTIC=true

# Security & CORS Origins (Set to your actual production frontend domain)
# Example: CORS_ORIGINS=["https://app.yourdomain.com"]
CORS_ORIGINS=["https://app.YOUR_DOMAIN.com"]

# Optional API Key Authentication (Leave empty for public API, or set token for protected endpoints)
API_KEY=

# Rate Limiting (Requests per minute per client IP)
RATE_LIMIT_PER_MINUTE=60

# Max Upload Size in Bytes (10MB = 10485760)
MAX_FILE_SIZE=10485760
